---
import Limits from "./Limits.astro";
// Counts match the skill's checklist (90 items).
const areas = [
  ["Uwierzytelnianie i autoryzacja", 16],
  ["Wstrzyknięcia (SQL, XSS, SSTI, polecenia)", 16],
  ["Kryptografia i tokeny", 12],
  ["Upload plików", 8],
  ["Logika biznesowa", 7],
  ["Zależności", 6],
  ["Współbieżność i wyścigi", 6],
  ["Ekspozycja danych i sekrety", 5],
  ["Nagłówki, CORS, transport", 4],
  ["Limity i nadużycia", 4],
  ["Logowanie i monitoring", 4],
  ["Zgodność dokumentacji z kodem", 2],
] as const;
const max = 16;
const always = [
  "znane podatności w\u00a0zależnościach",
  "sekrety w\u00a0całej historii gita",
  "lista miejsc, od których warto zacząć",
];
const stack = ["Next.js App Router", "tRPC", "Hono", "Drizzle", "Better-Auth", "AI SDK", "Node bez frameworka"];
---
<section class="section band" id="pokrycie">
  <div class="wrap split">
    <div>
      <h2 class="h2">Co sprawdza, a&nbsp;czego nie</h2>
      <p class="lead">12 obszarów i&nbsp;90 punktów kontrolnych. Każdy punkt kończy się znaleziskiem, obszarem bezpiecznym z&nbsp;dowodem albo wpisem „nie sprawdzone”.</p>

      <h3>Przy każdym audycie</h3>
      <ul class="plain">
        {always.map((s) => <li>{s}</li>)}
      </ul>

      <h3>Stack, który zna najlepiej</h3>
      <ul class="chips">
        {stack.map((s) => <li class="mono">{s}</li>)}
      </ul>
      <p class="fine">Python, PHP, Go, Ruby i&nbsp;Java działają na regułach ogólnych, mniej precyzyjnie.</p>

      <h3>W przygotowaniu</h3>
      <ul class="plain">
        <li>profile dla PHP, Pythona, Go i&nbsp;Rusta</li>
        <li>wykrywanie stacku i&nbsp;flaga <span class="mono">--stack</span></li>
        <li>więcej sprawdzeń dla CSRF, CI/CD i&nbsp;Dockera</li>
      </ul>
      <p class="fine">Bez terminów. Pełna lista z&nbsp;kryterium gotowości: <a href="/roadmap">roadmapa</a>. Nowe wersje dostajesz mailem jako aktualizacje.</p>
    </div>

    <ul class="areas" aria-label="Obszary i liczba punktów kontrolnych">
      {areas.map(([name, n]) => (
        <li>
          <span class="name">{name}</span>
          <span class="n mono">{n}</span>
          <span class="bar" aria-hidden="true"><i style={`width:${(n / max) * 100}%`}></i></span>
        </li>
      ))}
    </ul>
  </div>
  <Limits />
</section>

<style>
  h3 { font-size: var(--step-1); font-weight: 700; font-stretch: 108%; margin-top: 40px; }
  .areas { list-style: none; padding: 0; margin: 0; }
  .areas li { display: grid; grid-template-columns: minmax(0, 1fr) 2.5ch; gap: 6px 14px; padding: 14px 0; border-top: 1px solid var(--rule); align-items: baseline; }
  .areas li:last-child { border-bottom: 1px solid var(--rule); }
  .name { font-weight: 550; }
  .n { text-align: right; color: var(--ink-2); font-size: 0.9rem; }
  .bar { grid-column: 1 / -1; height: 4px; background: var(--rule); border-radius: 2px; overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--ink); border-radius: 2px; }
  .plain { margin: 12px 0 0; padding: 0; list-style: none; color: var(--ink-2); }
  .plain li { padding: 7px 0 7px 22px; position: relative; }
  .plain li::before { content: ""; position: absolute; left: 0; top: 1.05em; width: 12px; height: 2px; background: var(--accent); }
  .chips { list-style: none; padding: 0; margin: 14px 0 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .chips li { font-size: 0.82rem; padding: 6px 11px; border-radius: 8px; background: var(--surface); box-shadow: inset 0 0 0 1px var(--rule); }
</style>
