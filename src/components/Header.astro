---
import { SITE } from "../site";
// Six destinations in the bar; the menu (small screens) adds the home page's sections.
const primary = [
  ["/#przebieg", "Jak działa"],
  ["/przebiegi", "Wyniki"],
  ["/#instalacja", "Instalacja"],
  ["/#faq", "FAQ"],
  ["/#audyt", "Audyt"],
  ["/roadmap", "Roadmapa"],
];
const sections = [
  ["/#raport", "Raport"],
  ["/#prawdziwe", "Prawdziwe podatności"],
  ["/#uzycie", "Użycie"],
  ["/#pokrycie", "Co sprawdza"],
];
const here = Astro.url.pathname.replace(/\/$/, "") || "/";
const current = (href: string) => (href === here ? "page" : undefined);
---
<header class="top">
  <div class="wrap row">
    <a class="brand" href="/" aria-label={SITE.name}>
      <span class="mark" aria-hidden="true">/</span><span>security-audit</span>
    </a>
    <nav class="bar" aria-label="Główna">
      {primary.map(([href, label]) => <a href={href} aria-current={current(href)}>{label}</a>)}
    </nav>
    <a class="btn btn-primary cta-header" href={SITE.repo} rel="noopener">GitHub</a>
    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Menu">
        {[...primary.slice(0, 1), ...sections, ...primary.slice(1)].map(([href, label]) => (
          <a href={href} aria-current={current(href)}>{label}</a>
        ))}
        <a class="repo" href={SITE.repo} rel="noopener">GitHub</a>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the small-screen menu after a jump to a section on the same page.
  document.querySelectorAll<HTMLAnchorElement>(".menu nav a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
  );
</script>

<style>
  .top { position: sticky; top: 0; z-index: 5; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .row { display: flex; align-items: center; gap: 28px; height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; min-height: 44px; font: 600 1rem var(--mono); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
  .mark { color: var(--accent); }
  .bar { display: flex; gap: 26px; margin-left: auto; font-size: 0.95rem; }
  .bar a, .menu a { text-decoration: none; color: var(--ink-2); white-space: nowrap; }
  .bar a { padding-block: 6px; border-bottom: 2px solid transparent; }
  .bar a:hover { color: var(--ink); border-bottom-color: var(--accent); }
  .bar a[aria-current="page"] { color: var(--ink); border-bottom-color: var(--ink); }
  .cta-header { min-height: 44px; padding: 10px 16px; font-size: 0.95rem; white-space: nowrap; }

  .menu { display: none; position: relative; }
  .menu summary {
    list-style: none; cursor: pointer; min-height: 44px; display: inline-flex; align-items: center;
    padding: 0 14px; border-radius: 10px; box-shadow: inset 0 0 0 1px var(--ink); font-weight: 600; font-size: 0.95rem;
  }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { background: var(--ink); color: var(--paper); }
  .menu nav {
    position: absolute; right: 0; top: calc(100% + 10px); min-width: 230px; display: grid;
    background: var(--surface); border-radius: var(--radius); padding: 8px;
    box-shadow: 0 24px 48px -24px rgba(13, 19, 33, 0.35), 0 0 0 1px var(--rule);
  }
  .menu a { padding: 11px 12px; border-radius: 8px; }
  .menu a:hover, .menu a[aria-current="page"] { background: var(--accent-tint); color: var(--ink); }
  .menu .repo { margin-top: 6px; border-top: 1px solid var(--rule); border-radius: 0 0 8px 8px; color: var(--accent-strong); font-weight: 600; }
  @media (min-width: 421px) { .menu .repo { display: none; } }

  /* Below this width the six links no longer fit on one line next to the brand and the button. */
  @media (max-width: 980px) {
    .bar { display: none; }
    .cta-header { margin-left: auto; }
    .menu { display: block; }
  }
  @media (max-width: 420px) {
    .cta-header { display: none; }
    .menu { margin-left: auto; }
  }
</style>
