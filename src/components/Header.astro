---
import { SITE, zl } from "../site";
---
<header class="top">
  <div class="wrap row">
    <a class="brand" href="/" aria-label={SITE.name}>
      <span class="mark" aria-hidden="true">/</span><span>security-audit</span>
    </a>
    <nav aria-label="Sekcje">
      <a href="/#raport">Raport</a>
      <a href="/#przebieg">Jak działa</a>
      <a href="/#uzycie">Użycie</a>
      <a href="/#pokrycie">Co sprawdza</a>
      <a href="/#cennik">Cena</a>
      <a href="/#faq">FAQ</a>
      <a href="/roadmap">Roadmapa</a>
    </nav>
    <a class="btn btn-primary buy" href="/#cennik">Kup za {zl(SITE.price)}</a>
  </div>
</header>

<style>
  .top { position: sticky; top: 0; z-index: 5; background: var(--paper); border-bottom: 1px solid var(--rule); }
  .row { display: flex; align-items: center; gap: 24px; height: var(--header-h); }
  .brand { display: inline-flex; align-items: center; min-height: 44px; font: 600 1rem var(--mono); text-decoration: none; letter-spacing: -0.01em; }
  .mark { color: var(--accent); }
  nav { display: flex; gap: 22px; margin-left: auto; font-size: 0.95rem; }
  nav a { text-decoration: none; color: var(--ink-2); padding-block: 6px; }
  nav a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); }
  .buy { min-height: 44px; padding: 10px 16px; font-size: 0.95rem; }
  @media (max-width: 820px) {
    nav { display: none; }
    .buy { margin-left: auto; }
  }
</style>
