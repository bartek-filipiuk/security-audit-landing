---
const limits = [
  ["Nie zastępuje pentestu.", "Czyta kod i uruchamia dowody lokalnie. Nie atakuje produkcji i nie sprawdza infrastruktury."],
  ["Nie daje gwarancji.", "Brak znalezisk nie znaczy, że podatności nie ma. Dlatego raport ma listę „nie sprawdzone”."],
  ["Nie zna Twojej produkcji.", "Limity, proxy i zmienne środowiskowe wypisuje jako rzeczy do sprawdzenia po Twojej stronie."],
  ["Ma słabsze miejsca.", "CSRF, CI/CD i Docker mają dziś niewiele własnych punktów kontrolnych."],
];
---
<div class="wrap split limits" id="ograniczenia">
    <div>
      <h3 class="h3">Czego nie robi</h3>
      <p class="note">Lepiej wiedzieć to przed zakupem.</p>
    </div>
    <ul>
      {limits.map(([head, text]) => (
        <li>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M6.5 10h7"/></svg>
          <p><strong>{head}</strong> {text}</p>
        </li>
      ))}
    </ul>
</div>

<style>
  .limits { margin-top: clamp(48px, 7vw, 88px); }
  .h3 { font-size: var(--step-2); font-weight: 700; font-stretch: 108%; }
  .note { margin-top: 10px; color: var(--ink-2); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 14px; padding: 16px 0; border-top: 1px solid var(--rule); color: var(--ink-2); }
  li:last-child { border-bottom: 1px solid var(--rule); }
  svg { margin-top: 4px; color: var(--ink-3); }
  strong { color: var(--ink); font-weight: 650; }
</style>
