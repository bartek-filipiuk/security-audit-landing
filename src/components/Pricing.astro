---
import { SITE, zl } from "../site";
const included = [
  "Skill security-audit: paczka ZIP z instrukcją instalacji",
  "Aplikacja testowa z ukrytymi błędami i kluczem odpowiedzi",
  "Aktualizacje: nowa wersja przychodzi mailem",
  "Discord: pomoc w używaniu, bez gwarantowanego czasu odpowiedzi",
];
---
<section class="section tint" id="cennik">
  <div class="wrap">
    <article class="offer">
      <div class="left">
        <h2 class="h2">Jedna cena</h2>
        <p class="price"><span class="amount">{SITE.price}</span><span class="cur">zł</span></p>
        <p class="note">Płacisz raz. Używasz we własnych projektach, w&nbsp;pracy i&nbsp;u&nbsp;klientów. Masz 14&nbsp;dni na zwrot pieniędzy, bez pytań.</p>
        <a class="btn btn-primary" href={SITE.checkout}>Kup za {zl(SITE.price)}</a>
        <p class="alt">Albo z&nbsp;terminala, także w&nbsp;Claude Code: <code>npx devince-apps buy security-audit</code></p>
      </div>
      <div class="right">
        <ul>
          {included.map((i) => (
            <li>
              <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3.5 9.5l3.5 3.5 7.5-8"/></svg>
              <span>{i}</span>
            </li>
          ))}
        </ul>
        <p class="fine">Płatność kartą przez Stripe w&nbsp;sklepie apps.devince.dev, link do pobrania przychodzi mailem. Tokeny Claude zużywasz na własnym koncie.</p>
      </div>
    </article>
  </div>
</section>

<style>
  .tint { background: var(--accent-tint); }
  .offer { background: var(--surface); border-radius: var(--radius); box-shadow: inset 0 0 0 2px var(--accent); padding: clamp(28px, 5vw, 56px); display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; }
  .price { display: flex; align-items: baseline; gap: 10px; margin-top: 18px; line-height: 1; }
  .amount { font-size: clamp(4rem, 9vw, 6rem); font-weight: 760; font-stretch: 116%; letter-spacing: -0.03em; }
  .cur { font-size: var(--step-2); font-weight: 600; color: var(--ink-2); }
  .note { margin: 16px 0 26px; color: var(--ink-2); max-width: 36ch; }
  .alt { margin-top: 14px; font-size: var(--step--1); color: var(--ink-3); max-width: 40ch; }
  .alt code { font-size: 0.85em; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; font-size: var(--step-1); line-height: 1.4; }
  li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 14px; }
  li svg { margin-top: 6px; color: var(--accent); }
  .fine { margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--rule); }
  @media (max-width: 820px) { .offer { grid-template-columns: minmax(0, 1fr); } }
</style>
