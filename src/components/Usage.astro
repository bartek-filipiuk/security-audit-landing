---
const steps = [
  { name: "Uruchamiasz", text: "W swoim projekcie wpisujesz jedną komendę w Claude Code. Audytujesz cały projekt albo wybrany obszar." },
  { name: "Audyt pracuje sam", text: "Nie musisz niczego pilnować. Duży projekt zajmuje około dwóch godzin, mniejsze odpowiednio krócej." },
  { name: "Naprawiasz od góry", text: "Otwierasz raport. Każde znalezisko ma instrukcję naprawy, a po poprawkach sprawdzasz stan jeszcze raz." },
];
const commands = [
  ["/security-audit", "cały projekt"],
  ["/security-audit --scope auth", "logowanie, sesje, uprawnienia"],
  ["/security-audit --scope payments", "płatności"],
  ["/security-audit --scope src/api", "wybrany katalog"],
  ["/security-audit --scope top20", "20 najbardziej ryzykownych miejsc"],
  ["/security-audit --verify-fixes", "sprawdź, co już naprawione"],
];
---
<section class="section" id="uzycie">
  <div class="wrap">
    <h2 class="h2">Jak tego używasz</h2>
    <p class="lead">Jedna komenda, potem raport. Bez konfiguracji i&nbsp;bez konta w&nbsp;kolejnym serwisie.</p>

    <ol class="track">
      {steps.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p class="text">{s.text}</p>
        </li>
      ))}
    </ol>

    <figure class="term">
      <pre><code>{commands.map(([cmd, note]) => (
        <><span class="p">&gt;</span> {cmd.padEnd(36)}<span class="d">{note}</span>{"\n"}</>
      ))}</code></pre>
      <figcaption>Zakres wybierasz sam. Przy dużym projekcie warto zacząć od jednego obszaru.</figcaption>
    </figure>
  </div>
</section>

<style>
  .track { list-style: none; padding: 0; margin: clamp(36px, 5vw, 60px) 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 clamp(20px, 4vw, 48px); position: relative; }
  .track::before { content: ""; position: absolute; left: 5px; right: 0; top: 5px; height: 1px; background: var(--ink); }
  li { position: relative; padding-top: 28px; }
  li::before { content: ""; position: absolute; left: 0; top: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 2px var(--ink); }
  li:first-child::before, li:last-child::before { background: var(--accent); box-shadow: none; }
  h3 { font-size: var(--step-1); font-weight: 700; font-stretch: 108%; letter-spacing: -0.01em; }
  .text { color: var(--ink-2); margin-top: 8px; max-width: 34ch; }

  .term { margin: clamp(40px, 6vw, 72px) 0 0; }
  pre { margin: 0; background: var(--ink); color: #e8ebf5; border-radius: var(--radius); padding: clamp(18px, 3vw, 28px); overflow-x: auto; }
  pre code { background: none; color: inherit; padding: 0; font-size: clamp(0.8rem, 1.5vw, 0.95rem); line-height: 1.9; overflow-wrap: normal; white-space: pre; }
  .p { color: #8f9bff; } .d { color: #98a2bd; }
  .term figcaption { color: var(--ink-3); font-size: var(--step--1); margin-top: 12px; max-width: 70ch; }

  @media (max-width: 820px) {
    .track { grid-template-columns: minmax(0, 1fr); gap: 26px; }
    .track::before { left: 5px; right: auto; top: 6px; bottom: 6px; width: 1px; height: auto; }
    li { padding: 0 0 0 30px; }
    li::before { top: 6px; }
  }
</style>
