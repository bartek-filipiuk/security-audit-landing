---
import { SITE } from "../site";
const chapters = ["Komenda i wstępny skan", "Mapa aplikacji i audyt po obszarach", "Dwóch weryfikatorów równolegle", "Łańcuchy znalezisk i jakość testów", "Raport w przeglądarce"];
---
<section class="section" id="film">
  <div class="wrap split">
    <div>
      <h2 class="h2">Pełny przebieg w&nbsp;pięć minut</h2>
      <p class="lead">Ten sam audyt co wyżej, w&nbsp;całości: {SITE.video.minutes}&nbsp;minut zamiast 32. Bez komentarza, bez cięć w&nbsp;treści.</p>
      <p class="buildlog">Jak powstaje skill, pokazujemy w&nbsp;krótkich standupach na <a href={SITE.youtube} rel="noopener">YouTube</a>.</p>
      <ol>
        {chapters.map((c) => <li>{c}</li>)}
      </ol>
    </div>
    {SITE.video.url ? (
      <video class="player" controls preload="none" playsinline poster={SITE.video.poster} src={SITE.video.url} aria-label="Pełny przebieg audytu aplikacji testowej, przyspieszony"></video>
    ) : (
      <div class="player poster" role="img" aria-label="Nagranie w przygotowaniu">
        <svg width="64" height="64" viewBox="0 0 64 64" fill="none" aria-hidden="true"><circle cx="32" cy="32" r="30" stroke="currentColor" stroke-width="2"/><path d="M26 21v22l18-11z" fill="currentColor"/></svg>
        <p>Nagranie w&nbsp;przygotowaniu</p>
      </div>
    )}
  </div>
</section>

<style>
  .buildlog { margin-top: 12px; color: var(--ink-2); }
  ol { margin: 22px 0 0; padding-left: 1.3em; color: var(--ink-2); }
  ol li { padding: 4px 0; }
  ol li::marker { font-family: var(--mono); font-size: 0.85em; color: var(--accent-strong); }
  .player { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--radius); background: var(--ink); display: block; }
  .poster { display: grid; place-content: center; justify-items: center; gap: 14px; color: #c9cffb; }
  .poster p { font-size: 0.95rem; color: #98a2bd; }
</style>
